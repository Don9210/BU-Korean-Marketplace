# 이 파일을 복사해서 ".env" 로 저장하고 값을 채운다. (.env 는 GitHub 에 올라가지 않는다)
# 값은 Supabase → Project Settings → API 에서 복사. 모르면 동원에게 직접 받기.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 주의: Resend API Key 는 여기 넣지 않는다. Supabase Edge Function secret 에만 둔다.

# (선택) 시연용 체험 계정의 비밀번호. 비워 두면 로그인 화면에 체험 계정 버튼이 보이지 않는다.
# 실제 공개 전에는 반드시 비운다. 방법: docs/demo-accounts.md
VITE_DEMO_PASSWORD=
